<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/assistant_background">
    <com.courseschedule.ui.ScheduleRootLayout android:id="@+id/mainContent" android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@color/assistant_background">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar" android:layout_width="0dp" android:layout_height="60dp"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
            android:background="@color/assistant_background" app:navigationIcon="@drawable/ic_assistant_menu"
            app:navigationIconTint="@color/assistant_text" app:title="@string/assistant_title"
            app:titleTextColor="@color/assistant_text" app:subtitleTextColor="@color/assistant_text_secondary"
            app:titleTextAppearance="@style/Assistant.ToolbarTitle" app:subtitleTextAppearance="@style/Assistant.ToolbarSubtitle"
            app:titleCentered="true" app:subtitleCentered="true" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLatestMessages" style="@style/CourseSchedule.TextButton"
            android:layout_width="0dp" android:layout_height="40dp" android:minHeight="40dp" android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/toolbar" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
            android:text="@string/assistant_latest_messages" android:textColor="@color/assistant_accent" />
        <androidx.core.widget.NestedScrollView
            android:id="@+id/conversationScroll" android:layout_width="0dp" android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/btnLatestMessages" app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
            android:fillViewport="true" android:clipToPadding="false"
            android:overScrollMode="never" android:paddingHorizontal="16dp" android:paddingVertical="8dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <LinearLayout android:id="@+id/starterContent" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:paddingTop="8dp" android:paddingBottom="20dp">
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/assistant_hero_surface" app:cardCornerRadius="28dp" app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp" android:background="@drawable/bg_assistant_hero">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="今天，也从容一点" android:letterSpacing="0.02" android:textSize="10sp" android:fontFamily="sans-serif-medium" android:textColor="@color/assistant_hero_secondary" />
                    <com.courseschedule.view.ReferenceCalendarView android:layout_width="72dp" android:layout_height="72dp" android:contentDescription="@null" />
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="把日常，\n安排得刚刚好。" android:textSize="26sp" android:lineSpacingExtra="2dp" android:fontFamily="sans-serif-medium" android:textColor="@color/assistant_on_hero" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/assistant_chat_welcome" android:textSize="13sp" android:lineSpacingExtra="3dp" android:textColor="@color/assistant_hero_secondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:layout_marginStart="4dp" android:text="从一件小事开始" android:textSize="13sp" android:fontFamily="sans-serif-medium" android:textColor="@color/assistant_text_secondary" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal"><com.google.android.material.card.MaterialCardView android:id="@+id/btnExampleQuery"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:clickable="true" android:focusable="true" android:contentDescription="@string/assistant_quick_query"
            app:cardBackgroundColor="@color/assistant_prompt_query" app:cardCornerRadius="22dp" app:cardElevation="0dp"
            android:stateListAnimator="@animator/press_feedback" app:rippleColor="@color/control_focus_overlay">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="108dp" android:padding="16dp" android:orientation="vertical">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_assistant_schedule" app:tint="@color/reference_blue_accent" android:contentDescription="@null" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="看课表" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:textColor="@color/assistant_text" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="今天有哪些安排" android:textSize="11sp" android:textColor="@color/assistant_text_secondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView><com.google.android.material.card.MaterialCardView android:id="@+id/btnExampleReminder"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp"
            android:clickable="true" android:focusable="true" android:contentDescription="@string/assistant_quick_reminder"
            app:cardBackgroundColor="@color/assistant_prompt_change" app:cardCornerRadius="22dp" app:cardElevation="0dp"
            android:stateListAnimator="@animator/press_feedback" app:rippleColor="@color/control_focus_overlay">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="108dp" android:padding="16dp" android:orientation="vertical">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_assistant_reminder" app:tint="@color/reference_teal_accent" android:contentDescription="@null" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="提醒我" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:textColor="@color/assistant_text" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="吃饭、喝水、别忘了" android:textSize="11sp" android:textColor="@color/assistant_text_secondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal"><com.google.android.material.card.MaterialCardView android:id="@+id/btnExampleSimple"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:clickable="true" android:focusable="true" android:contentDescription="@string/assistant_quick_add"
            app:cardBackgroundColor="@color/assistant_prompt_add" app:cardCornerRadius="22dp" app:cardElevation="0dp"
            android:stateListAnimator="@animator/press_feedback" app:rippleColor="@color/control_focus_overlay">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="108dp" android:padding="16dp" android:orientation="vertical">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_add" app:tint="@color/reference_warm_accent" android:contentDescription="@null" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="加一门课" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:textColor="@color/assistant_text" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="一句话整理课程" android:textSize="11sp" android:textColor="@color/assistant_text_secondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView><com.google.android.material.card.MaterialCardView android:id="@+id/btnExampleDetails"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp"
            android:clickable="true" android:focusable="true" android:contentDescription="@string/assistant_quick_change"
            app:cardBackgroundColor="@color/assistant_prompt_delete" app:cardCornerRadius="22dp" app:cardElevation="0dp"
            android:stateListAnimator="@animator/press_feedback" app:rippleColor="@color/control_focus_overlay">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="108dp" android:padding="16dp" android:orientation="vertical">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_assistant_edit" app:tint="@color/reference_rose_accent" android:contentDescription="@null" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="调整课程" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:textColor="@color/assistant_text" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="修改时间和教室" android:textSize="11sp" android:textColor="@color/assistant_text_secondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView></LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnExampleDelete" style="@style/CourseSchedule.TextButton" android:layout_width="wrap_content" android:layout_height="48dp" android:visibility="gone" android:text="@string/assistant_quick_delete" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnConnectService" style="@style/CourseSchedule.TextButton"
            android:layout_width="wrap_content" android:layout_height="48dp" android:layout_gravity="center_horizontal" android:layout_marginTop="6dp"
            android:text="@string/assistant_connect_service" android:textColor="@color/assistant_accent" />
    </LinearLayout>
    <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOlderMessages" style="@style/CourseSchedule.TextButton"
                    android:layout_width="match_parent" android:layout_height="48dp" android:visibility="gone"
                    android:text="@string/assistant_older_messages" android:textColor="@color/assistant_accent" />
                <LinearLayout android:id="@+id/messagesContainer" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUndoLastAction" style="@style/CourseSchedule.TextButton"
                    android:layout_width="wrap_content" android:layout_height="48dp" android:visibility="gone"
                    android:text="@string/assistant_undo_action" android:contentDescription="@string/assistant_undo"
                    android:textColor="@color/assistant_accent" />
                <com.google.android.material.card.MaterialCardView
                android:id="@+id/targetChoiceCard" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:visibility="gone" android:layout_marginBottom="12dp" app:cardBackgroundColor="@color/assistant_pending_surface" app:cardCornerRadius="24dp"
                app:cardElevation="0dp" app:strokeWidth="0dp" app:strokeColor="@color/assistant_divider">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/assistant_choose_target_title" android:textColor="@color/assistant_text"
                        android:textSize="16sp" android:fontFamily="sans-serif-medium" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" android:text="@string/assistant_choose_target_hint"
                        android:textColor="@color/assistant_text_secondary" android:textSize="13sp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" android:gravity="end" android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCancelTargetChoice" style="@style/CourseSchedule.TextButton"
                            android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"
                            android:text="@string/cancel" android:textSize="14sp" app:cornerRadius="14dp"
                            android:insetTop="0dp" android:insetBottom="0dp" app:strokeWidth="0dp" app:strokeColor="@color/assistant_divider" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnChooseTarget" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"
                            android:layout_marginStart="10dp" android:text="@string/assistant_choose_target" android:textSize="14sp"
                            android:insetTop="0dp" android:insetBottom="0dp" android:stateListAnimator="@animator/press_feedback" android:elevation="0dp" app:cornerRadius="14dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/pendingCard" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:visibility="gone" android:layout_marginBottom="12dp" app:cardBackgroundColor="@color/assistant_pending_surface" app:cardCornerRadius="24dp"
                app:cardElevation="0dp" app:strokeWidth="0dp" app:strokeColor="@color/assistant_divider">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:id="@+id/tvPendingTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/assistant_pending_title" android:textColor="@color/assistant_text"
                        android:textSize="16sp" android:fontFamily="sans-serif-medium" />
                    <TextView android:id="@+id/tvPendingHint" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" android:text="@string/assistant_pending_hint"
                        android:textColor="@color/assistant_text_secondary" android:textSize="12sp" />
                    <TextView android:id="@+id/tvPendingSummary"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="14dp" android:lineSpacingExtra="4dp"
                        android:textColor="@color/assistant_text" android:textSize="14sp" android:textIsSelectable="true" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="18dp" android:gravity="end" android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCancelPending" style="@style/CourseSchedule.TextButton"
                            android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"
                            android:text="@string/cancel" android:textSize="14sp" android:textColor="@color/assistant_accent"
                            android:insetTop="0dp" android:insetBottom="0dp" app:cornerRadius="14dp"
                            app:strokeWidth="0dp" app:strokeColor="@color/assistant_divider" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnConfirmPending"
                            android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:layout_marginStart="10dp"
                            android:text="@string/assistant_confirm_changes" android:textSize="14sp" app:cornerRadius="14dp"
                            android:insetTop="0dp" android:insetBottom="0dp" android:stateListAnimator="@animator/press_feedback" android:elevation="0dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        <com.courseschedule.ui.ScheduleNavigationGlass android:id="@+id/navigationGlass"
            android:layout_width="0dp" android:layout_height="108dp" android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <LinearLayout android:id="@+id/chatFooter" android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical"
            app:layout_constraintBottom_toTopOf="@id/bottomNavigation" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetryRequest" style="@style/CourseSchedule.TextButton"
            android:layout_width="match_parent" android:layout_height="48dp" android:visibility="gone"
            android:text="@string/assistant_retry_request" android:textColor="@color/assistant_accent" />
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/composerCard" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp" android:layout_marginTop="4dp" android:layout_marginBottom="6dp"
            app:cardBackgroundColor="@color/assistant_soft_surface" app:cardCornerRadius="26dp" app:cardElevation="0dp"
            app:strokeWidth="0dp" app:strokeColor="@color/assistant_divider">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="8dp">
                <LinearLayout android:id="@+id/imagePreview" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="8dp" android:visibility="gone">
                    <ImageView android:id="@+id/ivSelectedImage" android:layout_width="56dp" android:layout_height="56dp"
                        android:scaleType="centerCrop" android:contentDescription="@string/assistant_image_view" android:clickable="true" android:focusable="true" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/assistant_image_selected" android:textColor="@color/assistant_text" android:textSize="13sp" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/assistant_image_hint" android:textColor="@color/assistant_text_secondary" android:textSize="11sp" />
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnRemoveImage" style="@style/CourseSchedule.TextButton"
                        android:layout_width="48dp" android:layout_height="48dp" android:minWidth="0dp" android:padding="0dp" android:text="×" android:textSize="24sp" android:contentDescription="@string/assistant_image_remove" />
                </LinearLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/inputMessage" android:layout_width="match_parent" android:layout_height="wrap_content"
                    app:boxBackgroundMode="none" app:hintEnabled="false">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etMessage" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:background="@null" android:gravity="top|start" android:hint="@string/assistant_message_hint"
                        android:paddingHorizontal="12dp" android:paddingVertical="8dp" android:textColor="@color/assistant_text"
                        android:textColorHint="@color/assistant_text_secondary" android:textSize="15sp"
                        android:inputType="textCapSentences|textMultiLine" android:imeOptions="actionSend"
                        android:maxLength="2000" android:maxLines="4" android:minHeight="48dp" android:saveEnabled="false" />
                </com.google.android.material.textfield.TextInputLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnQuickPrompts" style="@style/CourseSchedule.TextButton"
                        android:layout_width="wrap_content" android:layout_height="48dp" android:minWidth="0dp"
                        android:text="@string/assistant_quick_prompts" android:textSize="12sp" android:textColor="@color/assistant_accent"
                        app:backgroundTint="@android:color/transparent" app:cornerRadius="18dp"
                        app:icon="@drawable/ic_add" app:iconTint="@color/assistant_accent" app:iconSize="18dp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnAttachImage" style="@style/CourseSchedule.TextButton"
                        android:layout_width="48dp" android:layout_height="48dp" android:minWidth="0dp" android:padding="0dp"
                        android:contentDescription="@string/assistant_attach_image" app:icon="@drawable/ic_assistant_image"
                        app:iconTint="@color/assistant_accent" app:iconPadding="0dp" app:iconSize="20dp" app:iconGravity="textStart" />
                    <LinearLayout android:id="@+id/progress" android:layout_width="0dp" android:layout_height="48dp"
                        android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:layout_width="20dp" android:layout_height="20dp" android:indeterminate="true"
                            app:indicatorSize="18dp" app:indicatorInset="0dp" app:trackThickness="2dp" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:layout_marginStart="8dp" android:text="@string/assistant_processing" android:maxLines="1"
                            android:ellipsize="end" android:textColor="@color/assistant_text_secondary" android:textSize="12sp" />
                    </LinearLayout>
                    <TextView android:id="@+id/tvComposerMode" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:gravity="end" android:layout_marginEnd="8dp" android:textSize="12sp"
                        android:textColor="@color/assistant_text_secondary" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSend" android:layout_width="48dp" android:layout_height="48dp"
                        android:minWidth="0dp" android:padding="0dp" android:insetTop="0dp" android:insetBottom="0dp"
                        android:stateListAnimator="@animator/press_feedback" android:elevation="0dp"
                        android:contentDescription="@string/assistant_send" app:cornerRadius="24dp" app:iconTint="@color/reference_capsule_content"
                        app:icon="@drawable/ic_assistant_send" app:iconSize="24dp" app:iconPadding="0dp"
                        app:backgroundTint="@color/reference_capsule" app:strokeColor="@color/reference_capsule_edge" app:strokeWidth="1dp" app:iconGravity="textStart" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView android:id="@+id/composerNotice" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp" android:layout_marginBottom="6dp" android:gravity="center"
            android:text="@string/assistant_composer_notice" android:textColor="@color/assistant_text_secondary" android:textSize="11sp" />
        </LinearLayout>
        <com.google.android.material.bottomnavigation.BottomNavigationView android:id="@+id/bottomNavigation"
            android:layout_width="0dp" android:layout_height="72dp" android:background="@android:color/transparent" android:elevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
            app:itemActiveIndicatorStyle="@style/CourseScheduleBottomNavigationActiveIndicator" app:itemIconSize="22dp"
            app:itemIconTint="@color/nav_item_color" app:itemTextColor="@color/reference_nav_text" app:itemRippleColor="@color/control_focus_overlay"
            app:itemHorizontalTranslationEnabled="false" app:labelVisibilityMode="labeled" app:menu="@menu/menu_bottom_navigation"
            app:itemTextAppearanceActive="@style/CourseSchedule.NavigationLabel" app:itemTextAppearanceInactive="@style/CourseSchedule.NavigationLabel"
            app:itemPaddingTop="12dp" app:itemPaddingBottom="12dp" />
    </com.courseschedule.ui.ScheduleRootLayout>
    <include android:id="@+id/historyPanel" layout="@layout/drawer_assistant_history"
        android:layout_width="320dp" android:layout_height="match_parent" android:layout_gravity="start" />
</androidx.drawerlayout.widget.DrawerLayout>
