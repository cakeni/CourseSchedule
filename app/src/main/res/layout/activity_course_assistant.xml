<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="64dp" android:background="@color/surface" app:navigationIcon="@drawable/ic_back" app:navigationIconTint="@color/primary_variant" app:title="@string/assistant_title" app:titleTextColor="@color/text_primary" app:subtitle="@string/assistant_subtitle" app:subtitleTextColor="@color/text_secondary" />
    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="16dp" android:layout_marginTop="12dp" android:layout_marginBottom="4dp" app:cardBackgroundColor="@color/surface" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeColor="@color/divider" app:strokeWidth="1dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="72dp" android:paddingHorizontal="14dp" android:paddingVertical="8dp" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:id="@+id/apiStatusIcon" android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="@null" android:src="@drawable/ic_settings" app:tint="@color/primary_variant" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/tvApiStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/assistant_api_needed" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" />
                <TextView android:id="@+id/tvApiModel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:ellipsize="end" android:maxLines="1" android:text="@string/assistant_unconfigured" android:textColor="@color/text_secondary" android:textSize="12sp" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnConfigureApi" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginStart="4dp" android:minWidth="0dp" android:paddingHorizontal="10dp" android:text="@string/assistant_api_config" android:textColor="@color/primary_variant" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="20dp" android:layout_marginTop="4dp" android:text="@string/assistant_course_context_notice" android:textColor="@color/text_secondary" android:textSize="11sp" android:lineSpacingExtra="2dp" />
    <TextView android:id="@+id/tvAssistantNotice" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="20dp" android:textSize="12sp" android:textColor="@color/text_secondary" android:visibility="gone" android:accessibilityLiveRegion="polite" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/conversationList" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingHorizontal="16dp" android:paddingVertical="12dp" />
    <LinearLayout android:id="@+id/progress" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="20dp" android:visibility="gone">
        <com.google.android.material.progressindicator.CircularProgressIndicator android:layout_width="20dp" android:layout_height="20dp" android:indeterminate="true" app:indicatorSize="18dp" app:indicatorInset="0dp" app:trackThickness="2dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/assistant_processing" android:textColor="@color/text_secondary" android:textSize="12sp" android:id="@+id/tvRequestStage" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnStopRequest" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="48dp" android:visibility="gone" android:text="@string/assistant_stop_request" android:textColor="@color/primary_variant" />
    </LinearLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/btnRetryRequest" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="match_parent" android:layout_height="48dp" android:visibility="gone" android:text="@string/assistant_retry_request" android:textColor="@color/primary_variant" />
    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="12dp" android:layout_marginVertical="12dp" app:cardBackgroundColor="@color/surface" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:strokeColor="@color/divider" app:strokeWidth="1dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom" android:padding="8dp">
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/inputMessage" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" app:boxBackgroundMode="none" app:hintEnabled="false">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etMessage" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@null" android:gravity="top|start" android:hint="@string/assistant_message_hint" android:padding="12dp" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:textSize="15sp" android:inputType="textCapSentences|textMultiLine" android:imeOptions="actionSend" android:maxLength="2000" android:maxLines="4" android:minHeight="48dp" android:saveEnabled="false" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnSend" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginStart="4dp" android:minWidth="64dp" android:paddingHorizontal="14dp" android:text="@string/assistant_send" android:textSize="14sp" app:cornerRadius="18dp" android:insetTop="0dp" android:insetBottom="0dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>