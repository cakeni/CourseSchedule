<?xml version="1.0" encoding="utf-8"?>
<com.courseschedule.ui.ScheduleRootLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/task_page_background">
    <FrameLayout android:id="@+id/taskViewport" android:layout_width="0dp" android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <androidx.core.widget.NestedScrollView android:id="@+id/taskScroll" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false">
            <LinearLayout android:id="@+id/taskContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="24dp" android:paddingTop="22dp" android:paddingBottom="20dp" android:clipChildren="false" android:clipToPadding="false">
                <LinearLayout android:id="@+id/taskHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <ImageButton android:id="@+id/btnStudyBack" android:layout_width="40dp" android:layout_height="48dp" android:layout_marginEnd="4dp" android:background="@drawable/control_focus"
                        android:src="@drawable/ic_back" app:tint="@color/task_text" android:contentDescription="@string/back"  android:stateListAnimator="@animator/press_feedback_icon" />
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:id="@+id/tvTaskOverview" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/study_title"
                            android:textColor="@color/task_text" android:textSize="28sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" />
                        <TextView android:id="@+id/tvTaskCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp"
                            android:textColor="@color/task_secondary" android:textSize="13sp" />
                        <TextView android:id="@+id/tvTaskSemester" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                            android:textColor="@color/task_secondary" android:textSize="12sp" />
                    </LinearLayout>
                    <ImageButton android:id="@+id/btnStudyReminders" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginStart="8dp" android:background="@drawable/bg_reference_circle"
                        android:padding="12dp" android:src="@drawable/ic_assistant_reminder" app:tint="@color/task_text" android:contentDescription="@string/study_reminder_settings" />
                </LinearLayout>
                <TextView android:id="@+id/tvTaskReminderStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
                    android:minHeight="36dp" android:gravity="center_vertical" android:textColor="@color/task_secondary" android:textSize="12sp" android:lineSpacingExtra="3dp" android:visibility="gone" />
                <LinearLayout android:id="@+id/taskFilters" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="20dp" android:padding="4dp" android:background="@drawable/bg_task_filter_track" android:clipChildren="false" android:clipToPadding="false">
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnTasksToday" style="@style/Study.OverviewTile" android:text="@string/study_today" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnTasksUpcoming" style="@style/Study.OverviewTile" android:text="@string/study_upcoming" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnTasksPending" style="@style/Study.OverviewTile" android:text="@string/study_all" />
                </LinearLayout>
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/taskSearch" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp"
                    android:background="@drawable/bg_task_search" app:boxBackgroundMode="none" app:hintEnabled="false" app:startIconDrawable="@drawable/ic_search"
                    app:startIconTint="@color/task_secondary" app:endIconTint="@color/task_secondary" app:endIconMode="clear_text">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etTaskSearch" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@null"
                        android:paddingVertical="10dp" android:paddingHorizontal="12dp" android:minHeight="48dp" android:hint="@string/study_search" android:inputType="text" android:maxLines="1" android:maxLength="120" android:textSize="14sp" android:textColor="@color/task_text" android:textColorHint="@color/task_secondary" />
                </com.google.android.material.textfield.TextInputLayout>
                <LinearLayout android:id="@+id/taskListHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:gravity="center_vertical">
                    <TextView android:id="@+id/tvTaskListTitle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                        android:text="全部待办" android:textSize="17sp" android:fontFamily="sans-serif-medium" android:textColor="@color/task_text" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnTasksCompleted" style="@style/CourseSchedule.TextButton" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:minHeight="44dp" android:minWidth="0dp" android:text="已完成" android:textSize="12sp" android:fontFamily="sans-serif" android:checkable="true" android:textColor="@color/task_secondary" />
                </LinearLayout>
                <LinearLayout android:id="@+id/taskEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:paddingVertical="48dp">
                    <ImageView android:layout_width="34dp" android:layout_height="34dp" android:src="@drawable/ic_study_navigation" app:tint="@color/study_accent" android:contentDescription="@null" />
                    <TextView android:id="@+id/tvTaskEmptyTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:gravity="center" android:text="@string/study_empty_title" android:textSize="17sp" android:fontFamily="sans-serif-medium" android:textColor="@color/task_text" />
                    <TextView android:id="@+id/tvTaskEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
                        android:gravity="center" android:text="@string/study_empty" android:textSize="14sp" android:textColor="@color/task_secondary" android:lineSpacingExtra="6dp" />
                </LinearLayout>
                <LinearLayout android:id="@+id/taskRows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        <View android:layout_width="match_parent" android:layout_height="20dp" android:layout_gravity="bottom" android:background="@drawable/bg_task_scroll_edge" android:importantForAccessibility="no" />
    </FrameLayout>
    <com.courseschedule.ui.ScheduleNavigationGlass android:id="@+id/navigationGlass"
        android:layout_width="0dp" android:layout_height="108dp" android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    <com.google.android.material.button.MaterialButton android:id="@+id/btnAddTask"
        style="@style/CourseSchedule.Button" android:layout_width="wrap_content" android:minWidth="200dp" android:layout_height="wrap_content" android:minHeight="52dp" android:paddingHorizontal="28dp"
        android:layout_marginHorizontal="24dp" android:layout_marginTop="10dp" android:layout_marginBottom="14dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
        android:insetTop="0dp" android:insetBottom="0dp" android:text="@string/study_new" android:textSize="14sp"
        android:textColor="@color/task_on_action" android:fontFamily="sans-serif-medium"
        app:backgroundTint="@color/task_action" app:icon="@drawable/ic_add"
        app:iconTint="@color/task_on_action" app:iconSize="18dp" app:iconGravity="textStart"
        app:cornerRadius="26dp" app:strokeWidth="0dp"
        android:elevation="0dp" android:stateListAnimator="@animator/press_feedback" />
    <com.google.android.material.bottomnavigation.BottomNavigationView android:id="@+id/bottomNavigation" android:layout_width="0dp" android:layout_height="72dp"
        android:background="@android:color/transparent" android:elevation="0dp" app:itemActiveIndicatorStyle="@style/Study.NavigationIndicator"
        app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
        app:itemIconSize="22dp" app:itemIconTint="@color/study_navigation_color" app:itemTextColor="@color/reference_nav_text" app:itemRippleColor="@color/control_focus_overlay"
        app:itemHorizontalTranslationEnabled="false" app:labelVisibilityMode="labeled" app:menu="@menu/menu_bottom_navigation"
        app:itemTextAppearanceActive="@style/CourseSchedule.NavigationLabel" app:itemTextAppearanceInactive="@style/CourseSchedule.NavigationLabel"
        app:itemPaddingTop="12dp" app:itemPaddingBottom="12dp" />
</com.courseschedule.ui.ScheduleRootLayout>
