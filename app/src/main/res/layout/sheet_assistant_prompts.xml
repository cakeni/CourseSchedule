<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:paddingHorizontal="20dp" android:paddingTop="10dp" android:paddingBottom="24dp">
    <View android:layout_width="32dp" android:layout_height="4dp" android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp" android:background="@drawable/bg_assistant_sheet_handle" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp"
        android:text="@string/assistant_quick_prompts" android:textColor="@color/assistant_text" android:textSize="18sp" android:fontFamily="sans-serif-medium" />
    <com.google.android.material.button.MaterialButton android:id="@+id/btnPromptAdd" style="@style/CourseSchedule.TextButton"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:gravity="start|center_vertical"
        android:text="@string/assistant_example_simple" android:textSize="14sp" android:textColor="@color/assistant_accent" app:cornerRadius="14dp" app:icon="@drawable/ic_add" app:iconSize="20dp" app:iconTint="@color/assistant_accent" />
    <com.google.android.material.button.MaterialButton android:id="@+id/btnPromptQuery" style="@style/CourseSchedule.TextButton"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:gravity="start|center_vertical"
        android:text="@string/assistant_example_query" android:textSize="14sp" android:textColor="@color/assistant_accent" app:cornerRadius="14dp" app:icon="@drawable/ic_search" app:iconSize="20dp" app:iconTint="@color/assistant_accent" />
    <com.google.android.material.button.MaterialButton android:id="@+id/btnPromptChange" style="@style/CourseSchedule.TextButton"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:gravity="start|center_vertical"
        android:text="@string/assistant_example_details" android:textSize="14sp" android:textColor="@color/assistant_accent" app:cornerRadius="14dp" app:icon="@drawable/ic_assistant_edit" app:iconSize="20dp" app:iconTint="@color/assistant_accent" />
    <com.google.android.material.button.MaterialButton android:id="@+id/btnPromptDelete" style="@style/CourseSchedule.TextButton"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:gravity="start|center_vertical"
        android:text="@string/assistant_example_delete" android:textSize="14sp" android:textColor="@color/assistant_accent" app:cornerRadius="14dp" app:icon="@drawable/ic_assistant_delete" app:iconSize="20dp" app:iconTint="@color/assistant_accent" />
    <com.google.android.material.button.MaterialButton android:id="@+id/btnPromptReminder" style="@style/CourseSchedule.TextButton"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:gravity="start|center_vertical"
        android:text="明天12:00提醒我吃饭" android:textSize="14sp" android:textColor="@color/assistant_accent" app:cornerRadius="14dp" app:icon="@drawable/ic_assistant_reminder" app:iconSize="20dp" app:iconTint="@color/assistant_accent" />
</LinearLayout>
