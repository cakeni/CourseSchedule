<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:background="@color/assistant_background" android:paddingHorizontal="16dp" android:focusableInTouchMode="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/assistant_history" android:textSize="17sp" android:fontFamily="sans-serif-medium" android:textColor="@color/assistant_text" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnCloseHistory"
            style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="48dp" android:layout_height="48dp"
            android:minWidth="0dp" android:padding="0dp" android:contentDescription="@string/assistant_close_history"
            app:icon="@drawable/ic_back" app:iconTint="@color/assistant_text_secondary" app:iconPadding="0dp" app:iconGravity="textStart" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:layout_marginBottom="12dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/bg_assistant_soft">
        <com.google.android.material.textfield.TextInputLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" app:boxBackgroundMode="none" app:hintEnabled="false" app:endIconMode="clear_text">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etHistorySearch"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/assistant_drawer_search_hint"
                android:textSize="14sp" android:inputType="text" android:maxLength="100" android:maxLines="1" android:imeOptions="actionSearch"
                android:background="@null" android:paddingStart="16dp" android:paddingEnd="0dp" android:paddingVertical="12dp"
                android:textColor="@color/assistant_text" android:textColorHint="@color/assistant_text_secondary" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnHistorySearch"
            style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="48dp" android:layout_height="48dp"
            android:minWidth="0dp" android:padding="0dp" android:contentDescription="@string/assistant_history_search"
            app:icon="@drawable/ic_search" app:iconTint="@color/assistant_text_secondary" app:iconPadding="0dp" app:iconGravity="textStart" />
    </LinearLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/btnDrawerNewConversation"
        style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="match_parent" android:layout_height="48dp"
        android:text="@string/assistant_new_conversation" android:textSize="14sp" android:textColor="@color/assistant_text" android:gravity="start|center_vertical"
        app:icon="@drawable/ic_assistant_new_chat" app:iconSize="20dp" app:iconTint="@color/assistant_text" app:cornerRadius="16dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/tvHistoryStatus" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:paddingVertical="6dp" android:textColor="@color/assistant_text_secondary" android:textSize="12sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnHistoryAll"
            style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="40dp"
            android:minHeight="40dp" android:text="@string/assistant_clear_search" android:textSize="12sp" android:visibility="gone" />
    </LinearLayout>
    <ListView android:id="@+id/historyResults" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:divider="@android:color/transparent" android:dividerHeight="4dp" android:clipToPadding="false" android:paddingBottom="8dp" />
    <LinearLayout android:id="@+id/historyFooter" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingTop="12dp" android:paddingBottom="8dp">
        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginBottom="12dp" android:background="@color/assistant_soft_surface" />
        <TextView android:id="@+id/tvHistorySemester" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="12sp" android:textColor="@color/assistant_text_secondary" android:maxLines="1" android:ellipsize="end" android:paddingHorizontal="8dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/apiStatusIcon" android:layout_width="20dp" android:layout_height="20dp"
                android:contentDescription="@null" android:src="@drawable/ic_assistant_service" app:tint="@color/assistant_text_secondary" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:orientation="vertical" android:layout_marginStart="8dp">
                <TextView android:id="@+id/tvApiStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/assistant_api_needed" android:textSize="12sp" android:textColor="@color/assistant_text" />
                <TextView android:id="@+id/tvApiModel" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/assistant_service_unconfigured" android:textSize="11sp" android:textColor="@color/assistant_text_secondary"
                    android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnConfigureApi"
                style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="48dp"
                android:minWidth="0dp" android:paddingHorizontal="8dp" android:text="@string/assistant_service_settings" android:textSize="12sp" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnDrawerReminders"
            style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="match_parent" android:layout_height="48dp"
            android:text="@string/assistant_reminder_settings" android:textSize="14sp" android:gravity="start|center_vertical" android:textColor="@color/assistant_text_secondary"
            app:icon="@drawable/ic_assistant_reminder" app:iconSize="20dp" app:iconTint="@color/assistant_text_secondary" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnReturnSchedule"
            style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="match_parent" android:layout_height="48dp"
            android:text="@string/assistant_return_schedule" android:textSize="14sp" android:gravity="start|center_vertical" android:textColor="@color/assistant_text_secondary"
            app:icon="@drawable/ic_assistant_schedule" app:iconSize="20dp" app:iconTint="@color/assistant_text_secondary" />
    </LinearLayout>
</LinearLayout>
