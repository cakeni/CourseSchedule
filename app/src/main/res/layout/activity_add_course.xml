                    <TextView style="@style/CourseEditor.Label" android:text="@string/editor_required_name" android:labelFor="@id/etCourseName" />
                </LinearLayout>
                <androidx.appcompat.widget.AppCompatEditText android:id="@+id/etCourseName" style="@style/CourseEditor.Field" android:hint="@string/editor_name_hint" android:textSize="25sp" android:fontFamily="sans-serif-medium" android:singleLine="true" android:inputType="textCapSentences" android:imeOptions="actionNext" android:layout_marginTop="6dp" android:minHeight="56dp" />
                <TextView android:id="@+id/nameError" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/editor_error" android:textSize="12sp" android:visibility="gone" android:accessibilityLiveRegion="polite" android:layout_marginBottom="8dp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/detailsGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_course_editor_group" android:layout_marginTop="14dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="18dp">
