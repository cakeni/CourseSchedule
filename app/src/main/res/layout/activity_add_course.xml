                    <TextView style="@style/CourseEditor.Label" android:text="@string/editor_weekday" android:layout_marginStart="10dp" />
                    <FrameLayout android:id="@+id/dayBar" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="2dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal">
                            <com.google.android.material.button.MaterialButton android:id="@+id/day1" style="@style/CourseEditor.Segment" android:layout_weight="1" android:text="@string/editor_day_1" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/day2" style="@style/CourseEditor.Segment" android:layout_weight="1" android:text="@string/editor_day_2" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/day3" style="@style/CourseEditor.Segment" android:layout_weight="1" android:text="@string/editor_day_3" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/day4" style="@style/CourseEditor.Segment" android:layout_weight="1" android:text="@string/editor_day_4" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/day5" style="@style/CourseEditor.Segment" android:layout_weight="1" android:text="@string/editor_day_5" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/day6" style="@style/CourseEditor.Segment" android:layout_weight="1" android:text="@string/editor_day_6" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/day7" style="@style/CourseEditor.Segment" android:layout_weight="1" android:text="@string/editor_day_7" />
