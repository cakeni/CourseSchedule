                    <androidx.appcompat.widget.AppCompatEditText android:id="@+id/etClassroom" style="@style/CourseEditor.Field" android:minHeight="56dp" android:hint="@string/editor_location_hint" android:inputType="text" android:singleLine="true" android:imeOptions="actionDone" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="12dp" />
                </LinearLayout>
            </LinearLayout>
            <TextView style="@style/CourseEditor.Section" android:text="@string/editor_schedule" />
