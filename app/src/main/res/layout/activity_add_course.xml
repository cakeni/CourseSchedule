                        <TextView android:id="@+id/tvSectionTimes" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="12sp" android:textColor="@color/editor_secondary" android:includeFontPadding="false" android:gravity="end" />
                    </LinearLayout>
                    <ImageView android:id="@+id/rowSectionsChevron" style="@style/CourseEditor.Chevron" android:contentDescription="@null" />
                </LinearLayout>
                <LinearLayout android:id="@+id/sectionPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="18dp" android:paddingBottom="12dp" android:visibility="gone">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView style="@style/CourseEditor.Label" android:text="@string/editor_start" android:layout_width="0dp" android:layout_weight="1" android:gravity="center" />
                        <View android:layout_width="32dp" android:layout_height="1dp" android:importantForAccessibility="no" />
                        <TextView style="@style/CourseEditor.Label" android:text="@string/editor_end" android:layout_width="0dp" android:layout_weight="1" android:gravity="center" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="132dp" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
                        <NumberPicker android:id="@+id/sectionStart" android:layout_width="0dp" android:layout_height="132dp" android:importantForAccessibility="yes" android:layout_weight="1" />
                        <TextView android:layout_width="32dp" android:layout_height="132dp" android:gravity="center" android:text="@string/editor_range_dash" android:textSize="16sp" android:textColor="@color/editor_secondary" />
                        <NumberPicker android:id="@+id/sectionEnd" android:layout_width="0dp" android:layout_height="132dp" android:importantForAccessibility="yes" android:layout_weight="1" />
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/sectionPanelDone" style="@style/CourseEditor.Segment" android:layout_width="match_parent" android:layout_weight="0" android:text="@string/editor_done" android:textColor="@color/editor_accent" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginHorizontal="18dp" android:background="@color/editor_line" />
                <LinearLayout android:id="@+id/rowWeeks" style="@style/CourseEditor.Row">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/editor_weeks" android:textSize="14sp" android:textColor="@color/editor_text" android:includeFontPadding="false" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="18dp" android:gravity="end">
                        <TextView android:id="@+id/tvWeeks" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end" android:textSize="15sp" android:textColor="@color/editor_text" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" />
                    </LinearLayout>
                    <ImageView android:id="@+id/rowWeeksChevron" style="@style/CourseEditor.Chevron" android:contentDescription="@null" />
                </LinearLayout>
                <LinearLayout android:id="@+id/weekPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="18dp" android:paddingBottom="12dp" android:visibility="gone">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView style="@style/CourseEditor.Label" android:text="@string/editor_start" android:layout_width="0dp" android:layout_weight="1" android:gravity="center" />
                        <View android:layout_width="32dp" android:layout_height="1dp" android:importantForAccessibility="no" />
                        <TextView style="@style/CourseEditor.Label" android:text="@string/editor_end" android:layout_width="0dp" android:layout_weight="1" android:gravity="center" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="132dp" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
                        <NumberPicker android:id="@+id/weekStart" android:layout_width="0dp" android:layout_height="132dp" android:importantForAccessibility="yes" android:layout_weight="1" />
                        <TextView android:layout_width="32dp" android:layout_height="132dp" android:gravity="center" android:text="@string/editor_range_dash" android:textSize="16sp" android:textColor="@color/editor_secondary" />
                        <NumberPicker android:id="@+id/weekEnd" android:layout_width="0dp" android:layout_height="132dp" android:importantForAccessibility="yes" android:layout_weight="1" />
                    </LinearLayout>
                    <FrameLayout android:id="@+id/weekTypeBar" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="4dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal">
                            <com.google.android.material.button.MaterialButton android:id="@+id/weekEvery" style="@style/CourseEditor.Segment" android:layout_weight="1" android:text="@string/every_week" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/weekOdd" style="@style/CourseEditor.Segment" android:layout_weight="1" android:text="@string/odd_week" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/weekEven" style="@style/CourseEditor.Segment" android:layout_weight="1" android:text="@string/even_week" />
                        </LinearLayout>
                        <View android:id="@+id/weekTypeIndicator" android:layout_width="18dp" android:layout_height="2dp" android:layout_gravity="bottom" android:background="@color/editor_accent" />
                    </FrameLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/weekPanelDone" style="@style/CourseEditor.Segment" android:layout_width="match_parent" android:layout_weight="0" android:text="@string/editor_done" android:textColor="@color/editor_accent" />
                </LinearLayout>
            </LinearLayout>
            <TextView android:id="@+id/formError" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:paddingHorizontal="4dp" android:textSize="13sp" android:textColor="@color/editor_error" android:accessibilityLiveRegion="polite" android:visibility="gone" />
            <TextView style="@style/CourseEditor.Section" android:text="@string/editor_appearance" />
            <LinearLayout android:id="@+id/appearanceGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_course_editor_group">
                <LinearLayout android:id="@+id/rowColor" style="@style/CourseEditor.Row">
                    <View android:id="@+id/colorPreview" android:layout_width="14dp" android:layout_height="14dp" android:layout_marginEnd="10dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/editor_color" android:textSize="14sp" android:textColor="@color/editor_text" android:includeFontPadding="false" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="18dp" android:gravity="end">
                        <TextView android:id="@+id/tvColor" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end" android:textSize="15sp" android:textColor="@color/editor_text" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" />
                    </LinearLayout>
                    <ImageView android:id="@+id/rowColorChevron" style="@style/CourseEditor.Chevron" android:contentDescription="@null" />
                </LinearLayout>
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerColors" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="16dp" android:paddingBottom="12dp" android:nestedScrollingEnabled="false" android:visibility="gone" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginHorizontal="18dp" android:background="@color/editor_line" />
                <LinearLayout android:id="@+id/rowReminder" style="@style/CourseEditor.Row">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/editor_reminder" android:textSize="14sp" android:textColor="@color/editor_text" android:includeFontPadding="false" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="18dp" android:gravity="end">
                        <TextView android:id="@+id/tvReminder" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end" android:textSize="15sp" android:textColor="@color/editor_text" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" />
                    </LinearLayout>
                    <ImageView android:id="@+id/rowReminderChevron" style="@style/CourseEditor.Chevron" android:contentDescription="@null" />
                </LinearLayout>
                <LinearLayout android:id="@+id/reminderPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="18dp" android:paddingBottom="8dp" android:orientation="vertical" android:visibility="gone" />
                <TextView android:id="@+id/tvReminderDisabled" style="@style/CourseEditor.Label" android:layout_marginHorizontal="18dp" android:layout_marginBottom="12dp" android:text="@string/editor_reminder_disabled" android:visibility="gone" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginHorizontal="18dp" android:background="@color/editor_line" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="18dp" android:paddingTop="16dp" android:paddingBottom="10dp" android:orientation="vertical">
                    <TextView style="@style/CourseEditor.Label" android:text="@string/editor_note" android:labelFor="@id/etNote" />
                    <androidx.appcompat.widget.AppCompatEditText android:id="@+id/etNote" style="@style/CourseEditor.Field" android:layout_marginTop="8dp" android:hint="@string/editor_note_hint" android:minLines="2" android:maxLines="5" android:gravity="top" android:inputType="textMultiLine|textCapSentences" />
                </LinearLayout>
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnDelete" style="@style/CourseSchedule.TextButton" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="14dp" android:text="@string/delete_course" android:textColor="@color/editor_error" android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout android:id="@+id/bottomActions" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="78dp" android:paddingHorizontal="24dp" android:paddingVertical="12dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@color/editor_background" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="16dp" android:orientation="vertical">
            <TextView android:id="@+id/tvSaveSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="@color/editor_text" android:fontFamily="sans-serif-medium" />
            <TextView android:id="@+id/tvSaveWeeks" style="@style/CourseEditor.Label" android:layout_marginTop="4dp" />
        </LinearLayout>
        <ProgressBar android:id="@+id/saveProgress" style="?android:attr/progressBarStyleSmall" android:layout_width="20dp" android:layout_height="20dp" android:layout_marginEnd="12dp" android:indeterminateTint="@color/editor_accent" android:visibility="gone" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnSave" style="@style/CourseSchedule.Button" android:layout_width="104dp" android:layout_height="48dp" android:insetTop="0dp" android:insetBottom="0dp" android:minWidth="0dp" android:paddingHorizontal="16dp" android:text="@string/editor_save" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:enabled="false" app:backgroundTint="@color/editor_accent" app:cornerRadius="14dp" app:strokeWidth="0dp" app:elevation="0dp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>