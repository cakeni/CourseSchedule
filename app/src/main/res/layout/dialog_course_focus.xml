<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="24dp" android:paddingBottom="32dp" android:id="@+id/courseDetailContent" android:focusableInTouchMode="true">
    <LinearLayout android:id="@+id/detailHero" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <View android:layout_width="38dp" android:layout_height="4dp" android:layout_gravity="center_horizontal" android:layout_marginTop="10dp" android:background="@drawable/bg_sheet_handle" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:gravity="center_vertical" android:orientation="horizontal">
            <androidx.appcompat.widget.AppCompatEditText android:id="@+id/tvDetailTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:fontFamily="sans-serif" android:includeFontPadding="false" android:maxLines="3" android:textColor="@color/course_focus_text" android:textSize="22sp" style="@style/CourseFocus.Field" android:hint="@string/course_focus_name_hint" android:inputType="textCapSentences|textMultiLine" android:imeOptions="actionNext" android:maxLength="120" android:layout_weight="1" android:textStyle="bold" android:layout_marginTop="0dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnFocusMore" android:text="" style="@style/CourseFocus.Choice" android:layout_width="48dp" android:layout_weight="0" android:layout_marginTop="0dp" android:layout_height="48dp" android:contentDescription="@string/course_focus_more" app:icon="@drawable/ic_more" app:iconTint="@color/primary" app:iconSize="24dp" app:iconPadding="0dp" />
            <ImageButton android:id="@+id/btnCloseCourse" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_course_focus_back" android:contentDescription="@string/back" android:padding="14dp" android:src="@drawable/ic_back" app:tint="@color/course_focus_text" android:visibility="gone" />
            <View android:id="@+id/detailCourseColor" android:layout_width="10dp" android:layout_height="10dp" android:importantForAccessibility="no" android:layout_marginEnd="10dp" android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
    <androidx.core.widget.NestedScrollView android:id="@+id/courseDetailScroll" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:layout_weight="1" android:clipToPadding="false" android:overScrollMode="never" android:paddingBottom="0dp">
        <LinearLayout android:id="@+id/detailForm" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/rowFocusWeeks" android:minHeight="64dp" android:clickable="true" android:focusable="true" android:background="@drawable/control_focus">
                <ImageView android:layout_width="30dp" android:layout_height="30dp" android:contentDescription="@null" android:src="@drawable/ic_today" app:tint="@color/detail_week" android:id="@+id/focusWeeksIcon" android:importantForAccessibility="no" />
                <TextView android:id="@+id/tvDetailWeeks" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="22dp" android:layout_weight="1" android:textColor="@color/course_focus_text" android:textSize="18sp" android:textIsSelectable="false" android:fontFamily="sans-serif" android:minHeight="48dp" android:gravity="center_vertical" />
                <ImageView android:id="@+id/focusWeeksChevron" android:layout_width="18dp" android:layout_height="18dp" android:layout_marginStart="12dp" android:src="@drawable/ic_chevron_right" android:importantForAccessibility="no" app:tint="@color/course_focus_secondary" android:visibility="gone" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:layout_marginTop="8dp" android:id="@+id/focusWeeksPanel">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
                        <TextView android:text="@string/editor_start" style="@style/CourseFocus.Label" android:layout_width="match_parent" android:gravity="center" />
                        <NumberPicker android:id="@+id/focusWeekStart" android:layout_width="match_parent" android:layout_height="132dp" android:importantForAccessibility="yes" android:contentDescription="@string/start_week" />
                    </LinearLayout>
                    <TextView android:layout_width="24dp" android:layout_height="132dp" android:gravity="center" android:text="—" android:textSize="18sp" android:textColor="@color/course_focus_secondary" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
                        <TextView android:text="@string/editor_end" style="@style/CourseFocus.Label" android:layout_width="match_parent" android:gravity="center" />
                        <NumberPicker android:id="@+id/focusWeekEnd" android:layout_width="match_parent" android:layout_height="132dp" android:importantForAccessibility="yes" android:contentDescription="@string/end_week" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton android:id="@+id/focusEveryWeek" android:text="@string/every_week" style="@style/CourseFocus.Choice" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/focusOddWeek" android:text="@string/odd_week" style="@style/CourseFocus.Choice" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/focusEvenWeek" android:text="@string/even_week" style="@style/CourseFocus.Choice" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnFocusWeeksDone" android:text="@string/editor_done" style="@style/CourseFocus.Choice" android:layout_width="match_parent" android:layout_weight="0" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/rowFocusTime" android:minHeight="64dp" android:layout_marginTop="0dp" android:clickable="true" android:focusable="true" android:background="@drawable/control_focus">
                <ImageView android:layout_width="30dp" android:layout_height="30dp" android:contentDescription="@null" android:src="@drawable/ic_time" app:tint="@color/detail_time" android:id="@+id/focusTimeIcon" android:importantForAccessibility="no" />
                <TextView android:id="@+id/tvDetailTime" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="22dp" android:layout_weight="1" android:textColor="@color/course_focus_text" android:textSize="18sp" android:textIsSelectable="false" android:fontFamily="sans-serif" android:minHeight="48dp" android:gravity="center_vertical" />
                <ImageView android:id="@+id/focusTimeChevron" android:layout_width="18dp" android:layout_height="18dp" android:layout_marginStart="12dp" android:src="@drawable/ic_chevron_right" android:importantForAccessibility="no" app:tint="@color/course_focus_secondary" android:visibility="gone" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:layout_marginTop="8dp" android:id="@+id/focusTimePanel">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton android:id="@+id/focusDay1" android:text="@string/editor_day_1" style="@style/CourseFocus.Choice" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/focusDay2" android:text="@string/editor_day_2" style="@style/CourseFocus.Choice" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/focusDay3" android:text="@string/editor_day_3" style="@style/CourseFocus.Choice" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/focusDay4" android:text="@string/editor_day_4" style="@style/CourseFocus.Choice" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/focusDay5" android:text="@string/editor_day_5" style="@style/CourseFocus.Choice" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/focusDay6" android:text="@string/editor_day_6" style="@style/CourseFocus.Choice" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/focusDay7" android:text="@string/editor_day_7" style="@style/CourseFocus.Choice" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
                        <TextView android:text="@string/editor_start" style="@style/CourseFocus.Label" android:layout_width="match_parent" android:gravity="center" />
                        <NumberPicker android:id="@+id/focusSectionStart" android:layout_width="match_parent" android:layout_height="132dp" android:importantForAccessibility="yes" android:contentDescription="@string/start_section" />
                    </LinearLayout>
                    <TextView android:layout_width="24dp" android:layout_height="132dp" android:gravity="center" android:text="—" android:textSize="18sp" android:textColor="@color/course_focus_secondary" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
                        <TextView android:text="@string/editor_end" style="@style/CourseFocus.Label" android:layout_width="match_parent" android:gravity="center" />
                        <NumberPicker android:id="@+id/focusSectionEnd" android:layout_width="match_parent" android:layout_height="132dp" android:importantForAccessibility="yes" android:contentDescription="@string/end_section" />
                    </LinearLayout>
                </LinearLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnFocusTimeDone" android:text="@string/editor_done" style="@style/CourseFocus.Choice" android:layout_width="match_parent" android:layout_weight="0" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:minHeight="64dp" android:orientation="horizontal">
                <ImageView android:layout_width="30dp" android:layout_height="30dp" android:contentDescription="@null" android:src="@drawable/ic_person" app:tint="@color/detail_teacher" android:id="@+id/focusTeacherIcon" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="22dp" android:layout_weight="1" android:orientation="vertical">
                    <androidx.appcompat.widget.AppCompatEditText android:id="@+id/tvDetailTeacher" style="@style/CourseFocus.Field" android:hint="@string/course_focus_teacher_hint" android:inputType="textPersonName" android:imeOptions="actionNext" android:maxLength="120" android:singleLine="true" android:layout_marginTop="0dp" android:textStyle="normal" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="18sp" android:fontFamily="sans-serif" />
                    <TextView android:id="@+id/tvTeacherHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/course_focus_missing_teacher" android:textColor="@color/course_focus_secondary" android:textSize="11sp" android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:minHeight="64dp">
                <ImageView android:layout_width="30dp" android:layout_height="30dp" android:contentDescription="@null" android:src="@drawable/ic_room" app:tint="@color/detail_room" android:id="@+id/focusRoomIcon" android:importantForAccessibility="no" />
                <androidx.appcompat.widget.AppCompatEditText android:id="@+id/tvDetailClassroom" style="@style/CourseFocus.Field" android:hint="@string/course_focus_room_hint" android:inputType="textCapSentences" android:imeOptions="actionNext" android:maxLength="120" android:singleLine="true" android:layout_marginTop="0dp" android:textStyle="normal" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="22dp" android:textSize="18sp" android:fontFamily="sans-serif" />
            </LinearLayout>
            <LinearLayout android:id="@+id/rowDetailNote" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:minHeight="64dp" android:orientation="horizontal" android:visibility="gone">
                <ImageView android:layout_width="30dp" android:layout_height="30dp" android:contentDescription="@null" android:src="@drawable/ic_text" app:tint="@color/text_secondary" android:importantForAccessibility="no" />
                <androidx.appcompat.widget.AppCompatEditText android:id="@+id/tvDetailNote" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:lineSpacingExtra="4dp" android:textColor="@color/course_focus_text" android:textSize="15sp" style="@style/CourseFocus.Field" android:hint="@string/course_focus_note_hint" android:inputType="textCapSentences|textMultiLine" android:imeOptions="actionDone" android:maxLength="2000" android:maxLines="5" android:fontFamily="sans-serif" android:layout_weight="1" android:layout_marginStart="22dp" android:textStyle="normal" />
            </LinearLayout>
            <com.google.android.material.card.MaterialCardView android:id="@+id/focusMorePanel" android:visibility="gone" style="@style/CourseFocus.Paper" android:layout_marginTop="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <TextView android:text="@string/course_focus_color" style="@style/CourseFocus.Label" />
                    <androidx.recyclerview.widget.RecyclerView android:id="@+id/focusColorChoices" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:nestedScrollingEnabled="false" />
                    <TextView android:text="@string/course_focus_reminder" style="@style/CourseFocus.Label" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/focusReminderChoices" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnFocusDelete" android:text="@string/delete_course" style="@style/CourseFocus.Choice" android:layout_width="match_parent" android:layout_weight="0" android:textColor="@color/error" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <TextView android:id="@+id/focusError" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="13sp" android:textColor="@color/error" android:visibility="gone" android:accessibilityLiveRegion="polite" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:layout_marginTop="12dp" android:id="@+id/focusConfirmation">
        <TextView android:id="@+id/focusConfirmationText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/course_focus_text" android:textSize="14sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnFocusKeep" android:text="@string/course_focus_keep" style="@style/CourseFocus.Choice" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnFocusDiscard" android:text="@string/course_focus_discard" style="@style/CourseFocus.Choice" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="12dp" android:id="@+id/focusActions" android:visibility="gone">
        <com.google.android.material.button.MaterialButton android:id="@+id/btnFocusCancel" android:text="@string/cancel" style="@style/CourseFocus.Choice" android:layout_width="64dp" android:layout_weight="0" android:layout_marginEnd="12dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnEditCourse" style="@style/CourseSchedule.Button" android:layout_width="wrap_content" android:layout_height="52dp" android:layout_gravity="center_horizontal" android:insetTop="0dp" android:insetBottom="0dp" android:minWidth="160dp" android:paddingHorizontal="28dp" android:text="@string/course_focus_save" android:textAllCaps="false" android:textColor="@color/course_focus_save_text" android:textSize="15sp" app:backgroundTint="@color/course_focus_save_background" app:cornerRadius="26dp" app:elevation="0dp" app:strokeWidth="0dp" app:strokeColor="@color/course_focus_action_edge" android:enabled="false" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>