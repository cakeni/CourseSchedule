<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="course_focus_backdrop">#F3F4F5</color>
    <color name="course_focus_background">#F5F5F5</color>
    <color name="course_focus_paper">#EBFFFFFF</color>
    <color name="course_focus_text">#202328</color>
    <color name="course_focus_secondary">#4B5868</color>
    <color name="course_focus_divider">#183C4654</color>
    <color name="course_focus_edge">#E1E4E8</color>
    <color name="course_focus_action">#202328</color>
    <color name="course_focus_action_text">#FFFFFF</color>
    <color name="course_focus_action_edge">#00000000</color>

    <string name="course_focus_heading">课程详情</string>
    <string name="course_focus_arrangement">课程安排</string>
    <string name="course_focus_time">上课时间</string>
    <string name="course_focus_room">教室</string>
    <string name="course_focus_teacher">授课教师</string>
    <string name="course_focus_note">备注</string>
    <string name="course_focus_edit">编辑课程</string>
    <string name="course_focus_save">保存修改</string>
    <string name="course_focus_name_hint">课程名称</string>
    <string name="course_focus_room_hint">添加教室</string>
    <string name="course_focus_teacher_hint">添加教师</string>
    <string name="course_focus_note_hint">添加备注</string>
    <string name="course_focus_weeks">上课周次</string>
    <string name="course_focus_more">颜色与提醒</string>
    <string name="course_focus_missing_teacher">课表中没有教师姓名，可直接在这里补充。</string>
    <string name="course_focus_unsaved">有未保存的修改</string>
    <string name="course_focus_keep">继续编辑</string>
    <string name="course_focus_discard">放弃修改</string>
    <string name="course_focus_delete_prompt">确定删除这门课程？</string>
    <string name="course_focus_color">课程颜色</string>
    <string name="course_focus_reminder">课前提醒</string>

    <style name="CourseFocus.Field" parent="Widget.AppCompat.EditText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:background">@null</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/course_focus_text</item>
        <item name="android:textColorHint">@color/course_focus_secondary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:selectAllOnFocus">false</item>
    </style>
    <style name="CourseFocus.Choice" parent="CourseSchedule.TextButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textColor">@color/course_focus_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:backgroundTint">@android:color/transparent</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">10dp</item>
    </style>

    <style name="CourseFocus.Paper" parent="Widget.MaterialComponents.CardView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="cardBackgroundColor">@color/course_focus_paper</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="strokeColor">@color/course_focus_edge</item>
    </style>
    <style name="CourseFocus.Label" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/course_focus_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="CourseFocus.Value" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/course_focus_text</item>
        <item name="android:textIsSelectable">true</item>
        <item name="android:textSize">18sp</item>
    </style>
</resources>
