<resources>
    <style name="Study.OverviewTile" parent="CourseSchedule.TextButton">
        <item name="android:layout_width">0dp</item><item name="android:layout_weight">1</item><item name="android:layout_height">wrap_content</item><item name="android:minHeight">44dp</item>
        <item name="android:minWidth">0dp</item><item name="android:gravity">center</item><item name="android:paddingHorizontal">6dp</item>
        <item name="android:insetTop">0dp</item><item name="android:insetBottom">0dp</item><item name="android:insetLeft">0dp</item><item name="android:insetRight">0dp</item>
        <item name="android:textSize">13sp</item><item name="android:textAllCaps">false</item><item name="android:lineSpacingExtra">0dp</item>
        <item name="android:textColor">@color/task_filter_text</item><item name="backgroundTint">@android:color/transparent</item><item name="cornerRadius">22dp</item><item name="strokeWidth">0dp</item>
        <item name="android:checkable">true</item><item name="android:stateListAnimator">@null</item><item name="android:elevation">0dp</item>
    </style>
    <style name="Study.NavigationIndicator" parent="">
        <item name="android:width">58dp</item><item name="android:height">34dp</item><item name="android:color">@android:color/transparent</item>
        <item name="shapeAppearance">@style/ShapeAppearance.CourseSchedule.NavigationIndicator</item><item name="marginHorizontal">4dp</item>
    </style>
    <style name="Study.Segment" parent="CourseSchedule.TextButton">
        <item name="android:layout_width">0dp</item><item name="android:layout_weight">1</item><item name="android:layout_height">48dp</item>
        <item name="android:minWidth">0dp</item><item name="android:insetTop">4dp</item><item name="android:insetBottom">4dp</item>
        <item name="android:insetLeft">3dp</item><item name="android:insetRight">3dp</item>
        <item name="android:textSize">14sp</item><item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/study_segment_text</item><item name="backgroundTint">@color/study_segment_surface</item>
        <item name="cornerRadius">11dp</item><item name="android:checkable">true</item>
        <item name="android:stateListAnimator">@animator/press_feedback</item><item name="android:elevation">0dp</item>
    </style>
    <style name="Study.FieldLabel" parent="">
        <item name="android:layout_width">wrap_content</item><item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/study_text_secondary</item><item name="android:textSize">12sp</item>
        <item name="android:paddingStart">4dp</item><item name="android:layout_marginTop">20dp</item><item name="android:layout_marginBottom">9dp</item>
    </style>
    <style name="Study.Divider" parent="">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">1dp</item><item name="android:layout_marginHorizontal">16dp</item><item name="android:background">@color/study_divider</item>
    </style>
</resources>
