<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CourseSchedule.CourseEditor" parent="Theme.CourseSchedule">
        <item name="colorPrimary">@color/editor_accent</item>
        <item name="colorOnPrimary">@color/editor_on_accent</item>
        <item name="colorSurface">@color/editor_surface</item>
        <item name="colorOnSurface">@color/editor_text</item>
        <item name="colorControlActivated">@color/editor_accent</item>
        <item name="android:colorAccent">@color/editor_accent</item>
        <item name="android:colorBackground">@color/editor_background</item>
        <item name="android:windowBackground">@color/editor_background</item>
        <item name="android:statusBarColor">@color/editor_background</item>
        <item name="android:navigationBarColor">@color/editor_background</item>
        <item name="android:textColorPrimary">@color/editor_text</item>
        <item name="android:textColorSecondary">@color/editor_secondary</item>
        <item name="android:textColorHint">@color/editor_secondary</item>
    </style>
    <style name="CourseEditor.Label" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/editor_secondary</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="CourseEditor.Section" parent="CourseEditor.Label">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:layout_marginTop">26dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:layout_marginStart">4dp</item>
    </style>
    <style name="CourseEditor.Field" parent="Widget.AppCompat.EditText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:background">@null</item>
        <item name="android:padding">0dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/editor_text</item>
        <item name="android:textColorHint">@color/editor_secondary</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:selectAllOnFocus">false</item>
    </style>
    <style name="CourseEditor.Segment" parent="CourseSchedule.TextButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:backgroundTint">@android:color/transparent</item>
        <item name="android:textColor">@color/editor_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">8dp</item>
    </style>
    <style name="CourseEditor.Row" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">68dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingHorizontal">18dp</item>
        <item name="android:paddingVertical">14dp</item>
        <item name="android:background">@drawable/control_focus</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:stateListAnimator">@animator/press_feedback_row</item>
    </style>
    <style name="CourseEditor.Chevron" parent="">
        <item name="android:layout_width">16dp</item>
        <item name="android:layout_height">16dp</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:src">@drawable/ic_chevron_right</item>
        <item name="android:tint">@color/editor_secondary</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
</resources>
