<?xml version="1.0" encoding="utf-8"?>
<!--
  HyperOS Home classifies transparent, pre-rounded icons as non-square and
  normalizes them again. Keep this launcher-activity icon fully opaque and let
  the launcher apply its own mask.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size
                android:width="108dp"
                android:height="108dp" />
            <solid android:color="@color/ic_launcher_background" />
        </shape>
    </item>
    <item
        android:width="108dp"
        android:height="108dp"
        android:gravity="center">
        <bitmap
            android:antialias="true"
            android:filter="true"
            android:gravity="fill"
            android:src="@drawable/ic_launcher_foreground_artwork" />
    </item>
</layer-list>
